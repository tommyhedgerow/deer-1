# Drizzle / database
# Local development uses a SQLite file.
# Production must use a hosted libSQL database such as Turso:
#   DATABASE_URL=libsql://<db-name>-<org>.turso.io
#   DATABASE_AUTH_TOKEN=<token from `turso db tokens create <db-name>`>
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# The public origin. Must be the real site URL in production, e.g.
# https://your-site.netlify.app — better-auth derives callbacks and redirects
# from it, so a localhost value breaks sign-in once deployed.
ORIGIN="http://localhost:5173"

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""
